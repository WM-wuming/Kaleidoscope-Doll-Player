{
	"schemaVersion": 1,
	"id": "kaleidoscope_doll_player",
	"version": "${version}",
	"name": "森罗物语：玩偶·玩家",
	"description": "An unofficial Fabric port of Kaleidoscope Doll Workshop with direct PNG skin links, LittleSkin fallback, and skin snapshots.",
	"authors": [
		"Li Suchen"
	],
	"contributors": [
		"ysbb"
	],
	"contact": {
		"sources": "https://github.com/WM-wuming/Kaleidoscope-Doll-Player",
		"issues": "https://github.com/WM-wuming/Kaleidoscope-Doll-Player/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/kaleidoscope_doll_player/textures/item/workshop_icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"kaleidoscopeDollPlayer.KaleidoscopeDollPlayer"
		],
		"client": [
			"kaleidoscopeDollPlayer.KaleidoscopeDollPlayerClient"
		]
	},
	"mixins": [
		"kaleidoscope_doll_player.mixins.json",
		{
			"config": "kaleidoscope_doll_player.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "=${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"geckolib": ">=${geckolib_version}",
		"kaleidoscope_doll": "*"
	}
}
